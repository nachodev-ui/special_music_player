{
  "name": "usagi-music-room",
  "version": "0.1.0",
  "private": true,
  "description": "Un pequeño rincón de música local, inspirado en Usagi.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "pack": "npm run gift:prepare && npm run build && electron-builder --dir",
    "test:notes": "node --test scripts/song-notes.test.mjs",
    "test:artwork": "node --test scripts/artwork.test.mjs",
    "test:artwork:electron": "electron scripts/artwork-smoke.mjs",
    "gift:prepare": "node scripts/prepare-gift.mjs",
    "gift:dist": "npm run gift:prepare && npm run build && electron-builder --win portable",
    "test:gift": "node --test scripts/gift.test.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.0",
    "@fontsource/zen-maru-gothic": "^5.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^0.577.0",
    "motion": "^14.1.0",
    "music-metadata": "^12.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "local.usagi.musicroom",
    "productName": "Suki's Room",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "extraResources": [
      {
        "from": "gift-seed",
        "to": "gift",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "Sukis-Room-Regalo-${version}.${ext}",
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
