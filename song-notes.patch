@@ -0,0 +1,41 @@
+.song-note-card {
+  position: fixed;
+  z-index: 30;
+  right: 24px;
+  bottom: 119px;
+  width: min(390px, calc(100vw - 32px));
+  max-height: calc(100dvh - 185px);
+  overflow-y: auto;
+  padding: 18px;
+  border: 1px solid #edd9d9;
+  border-radius: 24px;
+  background: linear-gradient(145deg, #fffdf8, #fff0f4 72%, #fff5da);
+  color: #68565d;
+  box-shadow: 0 12px 38px #91758226, 0 3px 10px #91758210;
+  -webkit-app-region: no-drag;
+}
+.song-note-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 14px; }
+.song-note-heading > span { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 800; color: #a36d82; }
+.song-note-heading img { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; mix-blend-mode: multiply; }
+.song-note-track { display: flex; align-items: center; gap: 13px; margin-bottom: 17px; }
+.song-note-track > div:last-child { min-width: 0; }
+.song-note-artwork { width: 68px; height: 68px; border-radius: 17px; box-shadow: 0 4px 12px #91758216; }
+.song-note-label { font-size: 8px; font-weight: 800; letter-spacing: 1.3px; color: #a36d82; }
+.song-note-track h2 { margin: 4px 0; font-size: 17px; line-height: 1.3; overflow-wrap: anywhere; }
+.song-note-track p { margin: 0; font-size: 11px; color: #8e7882; overflow-wrap: anywhere; }
+.song-note-memory { margin: 0; padding: 14px; background: #fffdf9b3; border: 1px dashed #e7cbd4; border-radius: 16px; font-size: 13px; line-height: 1.8; white-space: pre-wrap; overflow-wrap: anywhere; max-height: 180px; overflow-y: auto; }
+.song-note-hint { display: flex; align-items: center; gap: 8px; font-size: 12px; line-height: 1.7; color: #8e7882; margin: 0; }
+.song-note-card textarea { display: block; width: 100%; margin-top: 8px; min-height: 106px; max-height: 180px; resize: vertical; padding: 12px; border: 1px solid #e7cbd4; border-radius: 14px; background: #fffdfb; color: #68565d; font: inherit; font-size: 12px; line-height: 1.7; -webkit-app-region: no-drag; }
+.song-note-card textarea::placeholder { color: #a28c95; }
+.song-note-card :focus-visible { outline: 2px solid #c28fa4; outline-offset: 3px; }
+.song-note-editor-footer { display: flex; justify-content: space-between; gap: 8px; color: #9c8790; font-size: 9px; margin-top: 6px; }
+.song-note-actions { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 13px; }
+.song-note-card .subtle-button { color: #a36d82; font-size: 11px; }
+.song-note-card .primary-button { background: #f7dde7; color: #8e5870; }
+.song-note-saved { display: flex; align-items: center; gap: 4px; font-size: 10px; color: #7c9067; }
+.song-note-error { font-size: 11px; line-height: 1.6; color: #a34e67; margin-top: 12px; }
+.song-note-announcement { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+.volume .song-note-toggle { color: #a36d82; }
+.volume .song-note-toggle.active { background: #f9e4ed; }
+@media (max-width: 950px) { .song-note-card { right: 16px; } .volume input { min-width: 40px; } }
+@media (prefers-reduced-motion: reduce) { .song-note-card *, .song-note-toggle { animation: none !important; transition: none !important; } }
diff --git a/scripts/song-notes.test.mjs b/scripts/song-notes.test.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/song-notes.test.mjs
@@ -0,0 +1,71 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, readFile, readdir, rm, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import ts from 'typescript';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const source = await readFile(path.join(root, 'electron/songNotes.ts'), 'utf8');
+const { outputText } = ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext } });
+const { SongNotes } = await import('data:text/javascript;base64,' + Buffer.from(outputText).toString('base64'));
+const first = 'a'.repeat(64), second = 'b'.repeat(64);
+
+async function scratch(t) {
+  const directory = await mkdtemp(path.join(root, '.song-notes-tests-'));
+  t.after(async () => {
+    const relative = path.relative(root, directory);
+    assert.ok(relative.startsWith('.song-notes-tests-') && !relative.includes(path.sep));
+    await rm(directory, { recursive: true, force: true });
+  });
+  return directory;
+}
+
+test('saves independent notes concurrently and restores them after restart', async t => {
+  const directory = await scratch(t);
+  const notes = new SongNotes(directory);
+  assert.equal(await notes.get(first), '');
+  await Promise.all([notes.set(first, ' Mi recuerdo ♡\nSegunda línea '), notes.set(second, 'Otra canción')]);
+  const restored = new SongNotes(directory);
+  assert.equal(await restored.get(first), 'Mi recuerdo ♡\nSegunda línea');
+  assert.equal(await restored.get(second), 'Otra canción');
+  assert.deepEqual(JSON.parse(await readFile(path.join(directory, 'song-notes.json'), 'utf8')), {
+    [first]: 'Mi recuerdo ♡\nSegunda línea', [second]: 'Otra canción',
+  });
+  assert.deepEqual(await readdir(directory), ['song-notes.json']);
+});
+
+test('edits and clears a note while preserving the other songs', async t => {
+  const notes = new SongNotes(await scratch(t));
+  await notes.set(first, 'Antes');
+  await notes.set(second, 'Mi otra nota');
+  await notes.set(first, 'Después');
+  assert.equal(await notes.get(first), 'Después');
+  await notes.set(first, '  ');
+  assert.equal(await notes.get(first), '');
+  assert.equal(await notes.get(second), 'Mi otra nota');
+});
+
+test('rejects invalid IDs and note payloads', async t => {
+  const notes = new SongNotes(await scratch(t));
+  await assert.rejects(notes.get('../library.json'));
+  assert.throws(() => notes.set('../library.json', 'texto'));
+  assert.throws(() => notes.set(first, { text: 'texto' }));
+  assert.throws(() => notes.set(first, 'x'.repeat(5001)));
+  await notes.set(first, 'Texto válido');
+  assert.equal(await notes.get(first), 'Texto válido');
+});
+
+test('preserves a damaged file and recovers the write queue after failure', async t => {
+  const directory = await scratch(t);
+  const filename = path.join(directory, 'song-notes.json');
+  await writeFile(filename, '{broken', 'utf8');
+  const notes = new SongNotes(directory);
+  await assert.rejects(notes.get(first));
+  await assert.rejects(notes.set(first, 'No sobrescribir'));
+  assert.equal(await readFile(filename, 'utf8'), '{broken');
+  await writeFile(filename, JSON.stringify({ [second]: 'Recuperada' }), 'utf8');
+  await notes.set(first, 'Nueva');
+  assert.equal(await notes.get(second), 'Recuperada');
+  assert.equal(await notes.get(first), 'Nueva');
+});
