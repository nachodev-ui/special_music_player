diff --git a/electron/songNotes.ts b/electron/songNotes.ts
new file mode 100644
--- /dev/null
+++ b/electron/songNotes.ts
@@ -0,0 +1,69 @@
+import { mkdir, readFile, rename, rm, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+export const MAX_NOTE_LENGTH = 5000;
+type Notes = Record<string, string>;
+
+export class SongNotes {
+  private readonly filename: string;
+  private queue: Promise<void> = Promise.resolve();
+
+  constructor(userData: string) {
+    this.filename = path.join(userData, 'song-notes.json');
+  }
+
+  private validateId(id: unknown): asserts id is string {
+    if (typeof id !== 'string' || !/^[a-f0-9]{64}$/.test(id)) {
+      throw new Error('Canción no válida.');
+    }
+  }
+
+  private async read(): Promise<Notes> {
+    let contents: string;
+    try { contents = await readFile(this.filename, 'utf8'); }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') return Object.create(null) as Notes;
+      throw error;
+    }
+    const parsed: unknown = JSON.parse(contents);
+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+      throw new Error('No se pudo leer el archivo de notas.');
+    }
+    const notes: Notes = Object.create(null) as Notes;
+    for (const [id, note] of Object.entries(parsed)) {
+      if (!/^[a-f0-9]{64}$/.test(id) || typeof note !== 'string' || note.length > MAX_NOTE_LENGTH) {
+        throw new Error('El archivo de notas contiene datos no válidos.');
+      }
+      notes[id] = note;
+    }
+    return notes;
+  }
+
+  async get(id: unknown): Promise<string> {
+    this.validateId(id);
+    await this.queue;
+    return (await this.read())[id] ?? '';
+  }
+
+  set(id: unknown, note: unknown): Promise<string> {
+    this.validateId(id);
+    if (typeof note !== 'string' || note.length > MAX_NOTE_LENGTH) {
+      throw new Error('La nota debe tener como máximo 5000 caracteres.');
+    }
+    const saved = note.trim();
+    const operation = this.queue.then(async () => {
+      const notes = await this.read();
+      if (saved) notes[id] = saved;
+      else delete notes[id];
+      await mkdir(path.dirname(this.filename), { recursive: true });
+      const temporary = this.filename + '.tmp';
+      try {
+        await writeFile(temporary, JSON.stringify(notes, null, 2) + '\n', 'utf8');
+        await rename(temporary, this.filename);
+      } finally { await rm(temporary, { force: true }); }
+      return saved;
+    });
+    this.queue = operation.then(() => {}, () => {});
+    return operation;
+  }
+}
diff --git a/src/features/player/useSongNotes.ts b/src/features/player/useSongNotes.ts
new file mode 100644
--- /dev/null
+++ b/src/features/player/useSongNotes.ts
@@ -0,0 +1,60 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+type NoteState = {
+  note: string;
+  draft: string;
+  loaded: boolean;
+  loading: boolean;
+  saving: boolean;
+  error: string;
+};
+const empty: NoteState = { note: '', draft: '', loaded: false, loading: true, saving: false, error: '' };
+
+export function useSongNotes(trackId?: string) {
+  const cache = useRef<Record<string, NoteState>>({});
+  const [entries, setEntries] = useState<Record<string, NoteState>>({});
+  const [retry, setRetry] = useState(0);
+  const patch = useCallback((id: string, values: Partial<NoteState>) => {
+    const next = { ...cache.current, [id]: { ...(cache.current[id] ?? empty), ...values } };
+    cache.current = next;
+    setEntries(next);
+  }, []);
+
+  useEffect(() => {
+    if (!trackId || cache.current[trackId]?.loaded) return;
+    let active = true;
+    patch(trackId, { loading: true, error: '' });
+    const desktop = window.desktop;
+    const request = desktop ? desktop.getSongNote(trackId) : Promise.reject(new Error('Desktop unavailable'));
+    request.then(note => {
+      if (active) patch(trackId, { note, draft: note, loaded: true, loading: false });
+    }).catch(() => {
+      if (active) patch(trackId, { loading: false, error: 'No pude leer tu nota. Intenta de nuevo.' });
+    });
+    return () => { active = false; };
+  }, [trackId, retry, patch]);
+
+  const entry = (trackId && entries[trackId]) || empty;
+  async function save(): Promise<boolean> {
+    if (!trackId || !entry.loaded || cache.current[trackId]?.saving || !window.desktop) return false;
+    const id = trackId;
+    patch(id, { saving: true, error: '' });
+    try {
+      const note = await window.desktop.saveSongNote(id, entry.draft);
+      patch(id, { note, draft: note, saving: false });
+      return true;
+    } catch {
+      patch(id, { saving: false, error: 'No pude guardar tu nota. Tu texto sigue aquí; vuelve a intentarlo.' });
+      return false;
+    }
+  }
+
+  return {
+    ...entry,
+    dirty: entry.draft !== entry.note,
+    setDraft: (draft: string) => { if (trackId) patch(trackId, { draft }); },
+    discard: () => { if (trackId) patch(trackId, { draft: entry.note, error: '' }); },
+    retry: () => setRetry(value => value + 1),
+    save,
+  };
+}
diff --git a/src/features/player/SongNoteCard.tsx b/src/features/player/SongNoteCard.tsx
new file mode 100644
--- /dev/null
+++ b/src/features/player/SongNoteCard.tsx
@@ -0,0 +1,88 @@
+import { useEffect, useRef, useState } from 'react';
+import { motion, useReducedMotion } from 'motion/react';
+import { Check, Heart, LoaderCircle, PencilLine, X } from 'lucide-react';
+import type { Track } from '../../../shared/contracts';
+import { Artwork } from '../../components/Artwork';
+import type { useSongNotes } from './useSongNotes';
+import './songNotes.css';
+
+type Notes = ReturnType<typeof useSongNotes>;
+export function SongNoteCard({ track, notes, onClose, playbackSequence }: { track: Track; notes: Notes; onClose: () => void; playbackSequence: number }) {
+  const reducedMotion = useReducedMotion();
+  const [editing, setEditing] = useState(notes.dirty);
+  const [hovered, setHovered] = useState(false);
+  const [focused, setFocused] = useState(false);
+  const [saved, setSaved] = useState(false);
+  const editButton = useRef<HTMLButtonElement>(null);
+  const wasEditing = useRef(editing);
+  useEffect(() => {
+    if (wasEditing.current && !editing) editButton.current?.focus();
+    wasEditing.current = editing;
+  }, [editing]);
+  const closeRef = useRef(onClose);
+  closeRef.current = onClose;
+
+  useEffect(() => {
+    if (editing || hovered || focused || notes.loading || notes.dirty || notes.error || notes.saving) return;
+    const timer = window.setTimeout(() => closeRef.current(), 8000);
+    return () => window.clearTimeout(timer);
+  }, [editing, hovered, focused, notes.loading, notes.dirty, notes.error, notes.saving, playbackSequence]);
+
+  function finishEditing() {
+    setEditing(false);
+  }
+
+  return <motion.section
+    id="song-note-card"
+    className="song-note-card"
+    aria-label={`Nota personal de ${track.title}`}
+    initial={{ opacity: 0, y: reducedMotion ? 0 : 16, scale: reducedMotion ? 1 : 0.97 }}
+    animate={{ opacity: 1, y: 0, scale: 1 }}
+    exit={{ opacity: 0, y: reducedMotion ? 0 : 10, scale: reducedMotion ? 1 : 0.98 }}
+    transition={{ duration: reducedMotion ? 0.1 : 0.35, ease: 'easeOut' }}
+    onMouseEnter={() => setHovered(true)}
+    onMouseLeave={() => setHovered(false)}
+    onFocusCapture={() => setFocused(true)}
+    onBlurCapture={event => { if (!event.currentTarget.contains(event.relatedTarget as Node | null)) setFocused(false); }}
+    onKeyDown={event => {
+      if (event.key === 'Escape') { event.stopPropagation(); onClose(); }
+      if (editing && (event.ctrlKey || event.metaKey) && event.key === 'Enter') {
+        event.preventDefault();
+        void notes.save().then(ok => { if (ok) { setSaved(true); finishEditing(); } });
+      }
+    }}
+  >
+    <div className="song-note-heading">
+      <span><img src="./characters/usagi.jpg" alt="" />Un recuerdo entre canciones ♡</span>
+      <button className="icon-button" aria-label="Cerrar nota personal" title="Cerrar" onClick={onClose}><X size={17} /></button>
+    </div>
+    <div className="song-note-track">
+      <Artwork track={track} className="song-note-artwork" />
+      <div><span className="song-note-label">ESTA CANCIÓN Y TÚ</span><h2>{track.title}</h2><p>{track.artist}</p></div>
+    </div>
+    <p className="song-note-announcement" role="status">{track.title} · {track.artist}</p>
+    {notes.loading ? <p className="song-note-hint" role="status"><LoaderCircle size={15} className="spinning" />Buscando tu pequeño recuerdo…</p> : <>
+      {editing ? <form onSubmit={event => {
+        event.preventDefault();
+        void notes.save().then(ok => { if (ok) { setSaved(true); finishEditing(); } });
+      }}>
+        <label className="song-note-label" htmlFor="song-note-text">¿QUÉ SIGNIFICA PARA TI?</label>
+        <textarea id="song-note-text" autoFocus maxLength={5000} rows={4} value={notes.draft}
+          placeholder="Un recuerdo, una persona, algo que sientes al escucharla…"
+          disabled={notes.saving} onChange={event => { notes.setDraft(event.target.value); setSaved(false); }} />
+        <div className="song-note-editor-footer"><span>{notes.draft.length}/5000</span><span>Ctrl + Enter para guardar</span></div>
+        <div className="song-note-actions">
+          <button type="button" className="subtle-button" disabled={notes.saving} onClick={() => { notes.discard(); finishEditing(); }}>Cancelar</button>
+          <button type="submit" className="primary-button" disabled={notes.saving || !notes.loaded}>{notes.saving ? <LoaderCircle size={14} className="spinning" /> : <Heart size={14} />} {notes.saving ? 'Guardando…' : 'Guardar mi nota'}</button>
+        </div>
+      </form> : <>
+        {notes.note ? <p className="song-note-memory">{notes.note}</p> : notes.loaded && <p className="song-note-hint">Esta canción puede guardar un pedacito de ti. Escribe lo que significa para ti ♡</p>}
+        <div className="song-note-actions">
+          <span className="song-note-saved" role="status">{saved && <><Check size={13} />Nota guardada ♡</>}</span>
+          <button ref={editButton} className="subtle-button" disabled={!notes.loaded} onClick={() => { setEditing(true); setSaved(false); }}><PencilLine size={14} />{notes.note ? 'Editar mi nota' : 'Escribir mi nota'}</button>
+        </div>
+      </>}
+      {notes.error && <div className="song-note-error" role="alert">{notes.error}{!notes.loaded && <button className="subtle-button" onClick={notes.retry}>Intentar de nuevo</button>}</div>}
+    </>}
+  </motion.section>;
+}
